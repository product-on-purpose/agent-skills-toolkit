# Gitignored working scratch (Standard sec 10.4): design drafts, session logs,
# agent-context material. Both casings, since the on-disk folder is _local but
# the Standard names the convention _LOCAL.
_local/
_LOCAL/

# Agent working context kept out of the public repo (session logs live here).
# docs/internal/ is the tracked "public internal" folder; this is the private one.
_agent-context/
.impeccable

# claude-mem local observation store (immutable session record, not source)
.memsearch/

# Node (validation spine lands in Phase 1)
node_modules/
npm-debug.log*
.DS_Store

# npm pack artefacts. RELEASE.md's publish step packs a tarball to preview what ships, and
# publish-npm.yml packs one on both paths. An untracked .tgz in the tree is a 200 kB build
# artefact one `git add -A` away from being committed.
*.tgz
